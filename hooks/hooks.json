{
  "description": "Guards git commit/push commands so documentation is updated alongside source file changes.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/docs-guardian/commit-guard.js\""
          }
        ]
      }
    ]
  }
}
